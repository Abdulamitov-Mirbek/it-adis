# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.
#
#   cp .env.production.example .env.production && nano .env.production
#
# docker compose reads this via --env-file; every variable below is consumed in
# docker-compose.prod.yml. The ones marked required have no default and Compose
# refuses to start without them, which is deliberate — a missing JWT_SECRET
# should stop the deploy, not produce a silently insecure API.

# ── Public identity ───────────────────────────────────────────────────────────
# Bare domain, no scheme, no trailing slash. Caddy requests the TLS certificate
# for exactly this name, and it is baked into the frontend image at build time
# as https://$SITE_DOMAIN for canonical and OpenGraph URLs.
SITE_DOMAIN=itadis.kg

# Where Let's Encrypt sends expiry warnings if renewal ever fails.
TLS_EMAIL=mmrek07@gmail.com

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Copy both from Supabase → Project Settings → Database → Connection string.
# DATABASE_URL is the pooled connection (port 6543) used by the running app.
# DIRECT_URL is the direct connection (port 5432); Prisma migrations need it
# because they run statements a transaction pooler cannot handle.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a FRESH one for production — do not reuse the local development
# value, and never the placeholder that used to be hardcoded in the source:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The API refuses to boot if this is missing, shorter than 32 characters, or one
# of the known placeholder strings.
JWT_SECRET=

# How long an admin session lasts. There is no refresh or revocation path, so
# this is the only limit on a leaked token's usefulness.
JWT_EXPIRES_IN=8h
