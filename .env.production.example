# Copy to .env.production ON THE SERVER and fill in. Never commit the real file.
#
#   cp .env.production.example .env.production && nano .env.production
#   chmod 600 .env.production
#
# Lives at /opt/itadis/.env.production, outside the git tree, so `git pull`
# cannot overwrite it. Three things read it:
#
#   * deploy/deploy-native.sh   (sources it for the build)
#   * the two systemd units     (EnvironmentFile=)
#   * docker compose --env-file (only if you go back to the Docker path)
#
# FORMAT: plain KEY=value, one per line, no `export`. Wrap a value in SINGLE
# quotes if it contains spaces. Nothing here is shell-expanded, so a password
# containing `$` or `#` survives intact either way — but prefer single quotes
# as a habit, because `"pa$$word"` is silently mangled by any other tool that
# sources this file with bash.

# DO NOT add NODE_ENV here. The systemd units set it themselves, and npm turns
# NODE_ENV=production into --omit=dev — which strips the build tools and breaks
# the build with a misleading "could not determine executable to run".
# deploy-native.sh defends against it with --include=dev, but leaving it out of
# this file avoids the trap for anything else that reads it.

# ── Public identity ───────────────────────────────────────────────────────────
# Bare domain, no scheme, no trailing slash. Caddy requests the TLS certificate
# for exactly this name, and it is baked into the frontend at build time as
# https://$SITE_DOMAIN for canonical and OpenGraph URLs.
#
# You may also put the server's IP here while you wait for a domain, e.g.
#   SITE_DOMAIN=13.60.233.228
# The deploy detects an IP and serves plain HTTP on :80, because Let's Encrypt
# only issues certificates for domain names — asking for HTTPS on a bare IP
# fails the ACME challenge and leaves Caddy serving nothing at all. Swap in a
# real domain later and HTTPS turns itself on with no other change.
SITE_DOMAIN=itadis.kg

# Where Let's Encrypt sends expiry warnings if renewal ever fails.
TLS_EMAIL=mmrek07@gmail.com

# ── Database (Supabase) ───────────────────────────────────────────────────────
# The API talks to Supabase over its REST API, not a Postgres connection, so
# there is no DATABASE_URL or DIRECT_URL any more — Prisma has been removed.
# Both values come from Supabase → Project Settings → API.
#
# The project URL. No trailing slash.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# The SECRET (service_role) key, not the publishable/anon one. It bypasses
# row-level security, which is why this backend can read admin_users and every
# applicant's contact details. It must never appear in the frontend, in
# NEXT_PUBLIC_* anything, or in a committed file. Rotate it in the Supabase
# dashboard if it is ever exposed.
SUPABASE_SECRET_KEY=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a FRESH one for production — do not reuse the local development
# value, and never the placeholder that used to be hardcoded in the source:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# The API refuses to boot if this is missing, shorter than 32 characters, or one
# of the known placeholder strings.
JWT_SECRET=

# How long an admin session lasts. There is no refresh or revocation path, so
# this is the only limit on a leaked token's usefulness.
JWT_EXPIRES_IN=8h
