// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

// ── Models ─────────────────────────────────────────────────

model Course {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  longDesc    String?
  duration    String
  level       CourseLevel
  price       Int         // in smallest currency unit (tyiyn)
  isActive    Boolean     @default(true)
  isFeatured  Boolean     @default(false)
  order       Int         @default(0)
  tags        String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  applications Application[]

  @@map("courses")
}

model Application {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  program   String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  courseId  String?
  course    Course?           @relation(fields: [courseId], references: [id])

  @@map("applications")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("student")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
