# Caddy config template for the Docker-free deployment.
#
# deploy-native.sh renders this to /etc/caddy/Caddyfile with envsubst and then
# validates it. Do not use Caddy's own {$VAR} placeholder syntax in this file:
# envsubst also matches the $VAR inside those braces, so `{$TLS_EMAIL}` came out
# as a literal `{}` and Caddy failed with "Unexpected '{}' at end of line" —
# whether or not the variable was set. Only bare ${VAR} belongs here.
#
# SITE_ADDRESS is computed by the script, not copied from .env.production:
#
#   * a real domain  -> `itadis.kg`, and Caddy fetches a Let's Encrypt
#     certificate automatically as soon as DNS points here
#   * an IP, or no domain yet -> `:80`, plain HTTP. Let's Encrypt cannot issue
#     a certificate for a bare IP address, so asking for HTTPS on one fails the
#     ACME challenge and Caddy then serves nothing at all.
#
# The global options block (with the ACME contact email) is prepended by the
# script, and only when a domain and TLS_EMAIL are both present.

${SITE_ADDRESS} {
	encode zstd gzip

	# Everything goes to Next.js, /api included: those are Next route handlers
	# that proxy to NestJS server-side over loopback. Do NOT add a route to
	# :3001 here — publishing the API is exactly what this design avoids.
	reverse_proxy 127.0.0.1:3000

	# Caddy already sends HSTS on HTTPS sites. These duplicate next.config.ts on
	# purpose: this layer also covers anything Caddy serves that never reaches
	# Next, such as its own error pages.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
