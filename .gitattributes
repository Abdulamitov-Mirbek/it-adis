# The repo is edited on Windows and runs on Linux. Without this, git checks the
# deploy scripts out with CRLF endings and bash on the EC2 host fails with
# "/usr/bin/env: 'bash\r': No such file or directory" — a confusing error for
# what is only a line-ending problem. Anything executed by a Linux shell, or
# parsed by a Linux daemon, is pinned to LF.

* text=auto

*.sh            text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
Caddyfile       text eol=lf
docker-compose*.yml text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.*.example  text eol=lf

# Binary assets git should never try to normalise.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.hdr binary
